<mjml>
  <mj-head>
    <mj-title>Otto</mj-title>
    <mj-preview>You’re on the list! Your store’s operator is almost here.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica Neue, Arial, sans-serif" />
      <mj-text color="#c4c0b3" font-size="16px" line-height="1.65" padding="0" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style>
      .serif div { font-family: Georgia, 'Times New Roman', serif !important; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#0e0e10" width="600px">
    <mj-wrapper background-color="#141416" border="1px solid #2a2a2f" border-radius="18px" padding="36px 28px">

      <!-- wordmark -->
      <mj-section>
        <mj-column>
          <mj-text css-class="serif" font-size="24px" font-weight="700" letter-spacing="-0.02em" color="#f1f0e9">
            Otto<span style="color:#e0b442;">.</span>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="16px 0 0">
        <mj-column>
          <mj-divider border-color="#2a2a2f" border-width="1px" padding="0" />
        </mj-column>
      </mj-section>

      <!-- kicker + headline + body -->
      <mj-section padding="18px 0 0">
        <mj-column>
          <mj-text font-size="11px" letter-spacing="3px" text-transform="uppercase" color="#e0b442">
            Closed beta
          </mj-text>
          <mj-text css-class="serif" font-size="30px" line-height="1.12" letter-spacing="-0.01em" color="#f1f0e9" padding="12px 0 0">
            Your store’s operator is almost here!
          </mj-text>
          <mj-text padding="18px 0 0">
            You’re on the list! We’ll email you the moment your spot opens!
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- centered CTA -->
      <mj-section padding="28px 0 0">
        <mj-column>
          <mj-button href="https://otto-livid-rho.vercel.app" align="center" background-color="#e0b442" color="#14130d" font-weight="700" font-size="15px" border-radius="999px" inner-padding="13px 28px">
            See what Otto does &rarr;
          </mj-button>
        </mj-column>
      </mj-section>

      <!-- sign-off -->
      <mj-section padding="24px 0 0">
        <mj-column>
          <mj-text css-class="serif" font-style="italic" font-size="16px" color="#9a9788">
            — The Otto team
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>

    <!-- footer -->
    <mj-section padding="18px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" line-height="1.6" color="#6f6c62">
          You’re receiving this because you joined the Otto waitlist.<br />
          <a href="{unsubscribe_link}" style="color:#8a8676; text-decoration:underline;">Unsubscribe</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
